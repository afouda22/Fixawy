@model DepartmentDetailsViewModel
@{ ViewData["Title"] = "Department Details"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">@Model.Department.Name</h1><p class="text-muted mb-0">@Model.Department.Description</p></div><div><a asp-action="Edit" asp-route-id="@Model.Department.Id" class="btn btn-outline-primary">Edit</a><a asp-action="Index" class="btn btn-outline-secondary ms-1">Back</a></div></div>
<div class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h2 class="h5 mb-0">Associated maintenance requests (@Model.Requests.Count)</h2></div><div class="card-body p-0">@if (Model.Requests.Count == 0){<div class="p-4 text-muted">No requests are linked to this department.</div>}else{<div class="table-responsive"><table class="table mb-0"><thead><tr><th>Title</th><th>Location</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var request in Model.Requests){<tr><td>@request.Title</td><td>@request.LocationName</td><td><span class="badge text-bg-secondary">@request.Status</span></td><td><a asp-controller="Maintenance" asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr>}</tbody></table></div>}</div></div>
<form asp-action="Delete" asp-route-id="@Model.Department.Id" method="post" class="mt-3" onsubmit="return confirm('Delete this department?');"><button type="submit" class="btn btn-outline-danger">Delete department</button></form>
