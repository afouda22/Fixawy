@model MaintenanceRequestDetailsPageViewModel
@{
	ViewData["Title"] = "Request Details";
	var request = Model.Request;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><div class="text-muted small">Maintenance request #@request.Id</div><h1 class="h3 mb-1">@request.Title</h1><div class="text-muted">Created @request.CreatedAt.ToLocalTime().ToString("f")</div></div><a asp-action="Index" class="btn btn-outline-secondary">Back to requests</a></div>
<div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="d-flex gap-2 mb-3"><span class="badge text-bg-secondary">@request.Status</span><span class="badge @(request.Priority == "Critical" ? "text-bg-danger" : request.Priority == "High" ? "text-bg-warning" : "text-bg-primary")">@request.Priority</span><span class="badge text-bg-dark">Score: @request.PriorityScore</span></div><h2 class="h5">Description</h2><p class="mb-0" style="white-space: pre-line">@request.Description</p></div></div><div class="card border-0 shadow-sm"><div class="card-header bg-transparent"><h2 class="h5 mb-0">Priority factors</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><div class="text-muted small">Impact scope</div><strong>@request.ImpactScope</strong></div><div class="col-md-4"><div class="text-muted small">Hazard level</div><strong>@request.HazardLevel</strong></div><div class="col-md-4"><div class="text-muted small">Location criticality</div><strong>@request.LocationCriticality</strong></div></div></div></div></div>
<div class="col-lg-4"><div class="card border-0 shadow-sm mb-4"><div class="card-header bg-transparent"><h2 class="h5 mb-0">Request information</h2></div><div class="card-body"><dl class="row mb-0"><dt class="col-5">Department</dt><dd class="col-7">@request.DepartmentName</dd><dt class="col-5">Location</dt><dd class="col-7">@request.LocationName</dd><dt class="col-5">Building</dt><dd class="col-7">@request.Building</dd><dt class="col-5">Floor</dt><dd class="col-7">@request.Floor</dd><dt class="col-5">Required skill</dt><dd class="col-7">@request.RequiredSkill</dd></dl></div></div><div class="card border-0 shadow-sm"><div class="card-header bg-transparent d-flex justify-content-between"><h2 class="h5 mb-0">Attachments</h2></div><div class="card-body">@if (Model.Attachments.Count == 0){<div class="text-muted small">No attachments.</div>}else{<ul class="list-group list-group-flush">@foreach (var attachment in Model.Attachments){<li class="list-group-item px-0 d-flex justify-content-between align-items-center"><span class="text-truncate me-2"><i class="bi bi-paperclip me-1"></i>@attachment.FileName<div class="small text-muted">@((attachment.FileSize / 1024d).ToString("N0")) KB</div></span><span class="d-flex gap-1"><a asp-action="DownloadAttachment" asp-route-attachmentId="@attachment.Id" class="btn btn-sm btn-outline-primary">Download</a><form asp-action="DeleteAttachment" asp-route-attachmentId="@attachment.Id" asp-route-ticketId="@request.Id" method="post" onsubmit="return confirm('Delete this attachment?');"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></span></li>}</ul>}</div></div></div></div>
