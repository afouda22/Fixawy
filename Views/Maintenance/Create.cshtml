@model CreateMaintenanceRequestViewModel
@{
	ViewData["Title"] = "Create Maintenance Request";
}

<div class="row justify-content-center"><div class="col-xl-9"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Create Maintenance Request</h1><p class="text-muted mb-0">Describe the issue so the dispatching team can prioritize it correctly.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm"><div class="card-body p-4"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
<div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="RequiredSkill" class="form-label"></label><input asp-for="RequiredSkill" class="form-control" placeholder="e.g. Electrical" /><span asp-validation-for="RequiredSkill" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="DepartmentId" class="form-label"></label><select asp-for="DepartmentId" class="form-select"><option value="">Select department</option>@foreach (var item in Model.Departments){<option value="@item.Id">@item.Name</option>}</select><span asp-validation-for="DepartmentId" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="LocationId" class="form-label"></label><select asp-for="LocationId" class="form-select"><option value="">Select location</option>@foreach (var item in Model.Locations){<option value="@item.Id">@item.Name (@item.Building @item.Floor)</option>}</select><span asp-validation-for="LocationId" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="ImpactScope" class="form-label"></label><select asp-for="ImpactScope" class="form-select"><option value="">Select impact</option>@foreach (var value in Enum.GetValues<ImpactScope>()){<option value="@value">@value</option>}</select><span asp-validation-for="ImpactScope" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="HazardLevel" class="form-label"></label><select asp-for="HazardLevel" class="form-select"><option value="">Select hazard</option>@foreach (var value in Enum.GetValues<HazardLevel>()){<option value="@value">@value</option>}</select><span asp-validation-for="HazardLevel" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="LocationCriticality" class="form-label"></label><select asp-for="LocationCriticality" class="form-select"><option value="">Select criticality</option>@foreach (var value in Enum.GetValues<LocationCriticality>()){<option value="@value">@value</option>}</select><span asp-validation-for="LocationCriticality" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Attachments" class="form-label"></label><input asp-for="Attachments" class="form-control" multiple accept=".jpg,.jpeg,.png,.pdf,.doc,.docx" /><div class="form-text">Maximum 10 MB per file. Allowed: JPG, PNG, PDF, DOC, DOCX.</div><span asp-validation-for="Attachments" class="text-danger"></span></div>
</div></div><div class="card-footer bg-transparent d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Submit request</button></div></form></div></div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
