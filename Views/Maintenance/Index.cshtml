@model MaintenanceRequestListPageViewModel
@{
	ViewData["Title"] = "Maintenance Requests";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
	<div><h1 class="h3 mb-1">Maintenance Requests</h1><p class="text-muted mb-0">@(ViewBag.CanViewAll == true ? "All authorized requests" : "Requests submitted by you")</p></div>
	<div class="d-flex gap-2"><a asp-action="Dashboard" class="btn btn-outline-primary">Dashboard</a><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New Request</a></div>
</div>

<form method="get" class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="row g-3 align-items-end">
	<div class="col-md-3"><label asp-for="Filter.Status" class="form-label">Status</label><select asp-for="Filter.Status" class="form-select"><option value="">All statuses</option>@foreach (var value in Enum.GetValues<TicketStatus>()){<option value="@value">@value</option>}</select></div>
	<div class="col-md-3"><label asp-for="Filter.Priority" class="form-label">Priority</label><select asp-for="Filter.Priority" class="form-select"><option value="">All priorities</option>@foreach (var value in Enum.GetValues<TicketPriority>()){<option value="@value">@value</option>}</select></div>
	<div class="col-md-3"><label asp-for="Filter.DepartmentId" class="form-label">Department</label><select asp-for="Filter.DepartmentId" class="form-select"><option value="">All departments</option>@foreach (var department in Model.Filter.Departments){<option value="@department.Id">@department.Name</option>}</select></div>
	<div class="col-md-3"><label asp-for="Filter.LocationId" class="form-label">Location</label><select asp-for="Filter.LocationId" class="form-select"><option value="">All locations</option>@foreach (var location in Model.Filter.Locations){<option value="@location.Id">@location.Name</option>}</select></div>
	<div class="col-md-3"><label asp-for="Filter.FromDate" class="form-label">From</label><input asp-for="Filter.FromDate" class="form-control" /></div>
	<div class="col-md-3"><label asp-for="Filter.ToDate" class="form-label">To</label><input asp-for="Filter.ToDate" class="form-control" /></div>
	<div class="col-md-3"><label asp-for="Filter.Sort" class="form-label">Sort</label><select asp-for="Filter.Sort" class="form-select"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="priority">Priority first</option></select></div>
	<div class="col-md-3"><button class="btn btn-dark w-100" type="submit"><i class="bi bi-funnel me-1"></i>Apply filters</button></div>
</div></div></form>

<div class="card border-0 shadow-sm"><div class="card-body p-0">
@if (Model.Requests.Count == 0){<div class="p-5 text-center text-muted"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No requests match the selected filters.</div>}
else {<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Request</th><th>Department</th><th>Location</th><th>Status</th><th>Priority</th><th>Created</th><th></th></tr></thead><tbody>@foreach (var request in Model.Requests){<tr><td><strong>@request.Title</strong><div class="small text-muted">#@request.Id</div></td><td>@request.DepartmentName</td><td>@request.LocationName<div class="small text-muted">@request.Building @request.Floor</div></td><td><span class="badge text-bg-secondary">@request.Status</span></td><td><span class="badge @(request.Priority == "Critical" ? "text-bg-danger" : request.Priority == "High" ? "text-bg-warning" : "text-bg-primary")">@request.Priority</span><div class="small text-muted">Score: @request.PriorityScore</div></td><td>@request.CreatedAt.ToLocalTime().ToString("g")</td><td><a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">Details</a></td></tr>}</tbody></table></div>}
</div></div>
@if (Model.TotalPages > 1){<nav class="mt-3"><ul class="pagination justify-content-center">@for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++){<li class="page-item @(pageNumber == Model.Filter.Page ? "active" : "")"><a class="page-link" href="@Url.Action("Index")?Filter.Page=@pageNumber">@pageNumber</a></li>}</ul></nav>}
