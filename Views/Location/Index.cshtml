@model IReadOnlyList<Location>
@{ ViewData["Title"] = "Locations"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Locations</h1><p class="text-muted mb-0">Manage buildings, floors, and maintenance locations.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New location</a></div>
<div class="card border-0 shadow-sm"><div class="card-body p-0">@if (Model.Count == 0){<div class="p-5 text-center text-muted">No locations have been created yet.</div>}else{<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Building</th><th>Floor</th><th>Description</th><th></th></tr></thead><tbody>@foreach (var location in Model){<tr><td class="fw-semibold">@location.Name</td><td>@(location.Building ?? "—")</td><td>@(location.Floor ?? "—")</td><td class="text-muted">@(location.Description ?? "—")</td><td class="text-end"><a asp-action="Details" asp-route-id="@location.Id" class="btn btn-sm btn-outline-primary">Details</a><a asp-action="Edit" asp-route-id="@location.Id" class="btn btn-sm btn-outline-secondary ms-1">Edit</a></td></tr>}</tbody></table></div>}</div></div>
