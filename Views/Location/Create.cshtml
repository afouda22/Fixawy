@model LocationFormViewModel
@{ ViewData["Title"] = "Create Location"; }
<div class="row justify-content-center"><div class="col-lg-7"><h1 class="h3 mb-4">Create Location</h1><form asp-action="Create" method="post" class="card border-0 shadow-sm"><div class="card-body"><partial name="_Form" model="Model" /></div><div class="card-footer bg-transparent d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">Create location</button></div></form></div></div>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
