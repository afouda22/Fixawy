@model Fixawyy.Model_Views.ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }
<div class="row justify-content-center py-5"><div class="col-md-6"><div class="card card-modern p-4 shadow-sm">
<h3>Change Password</h3><form asp-action="ChangePassword" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control" />
<label asp-for="NewPassword" class="form-label mt-3"></label><input asp-for="NewPassword" class="form-control" /><span asp-validation-for="NewPassword" class="text-danger"></span>
<label asp-for="ConfirmPassword" class="form-label mt-3"></label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span>
<button class="btn btn-primary mt-3" type="submit">Change Password</button></form></div></div></div>
