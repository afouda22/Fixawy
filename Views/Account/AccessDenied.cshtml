@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card card-modern p-5 bg-white shadow-lg">
            <span class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 68px; height: 68px;">
                <i class="bi bi-shield-x fs-1"></i>
            </span>
            <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
            <p class="text-muted mb-4">You do not have permission to view this resource. Please contact your administrator if you believe this is an error.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-yellow-modern">
                <i class="bi bi-house-door me-1"></i>Return to Home
            </a>
        </div>
    </div>
</div>