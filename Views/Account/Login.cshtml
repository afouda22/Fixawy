@model Fixawyy.Model_Views.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card card-modern border-0 shadow-lg overflow-hidden">
            <div class="card-auth-header"></div>
            <div class="p-4 p-sm-5">
                <div class="text-center mb-4">
                    <div class="d-inline-block rounded-circle p-1 mb-3" style="border: 2.5px solid #f5a623; box-shadow: 0 4px 12px rgba(245, 166, 35, 0.3);">
                        <img src="~/images/logo.jpg" alt="Fixawyy Logo" class="rounded-circle" style="width: 80px; height: 80px; object-fit: contain;" />
                    </div>
                    <h3 class="fw-bold mb-1">Welcome Back</h3>
                    <p class="text-muted small">Sign in to access your Fixawyy account</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0"><i class="bi bi-envelope text-primary"></i></span>
                            <input asp-for="Email" class="form-control form-control-modern border-start-0" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0"><i class="bi bi-key text-warning"></i></span>
                            <input asp-for="Password" class="form-control form-control-modern border-start-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-yellow-modern w-100 py-2.5 fs-6">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <a asp-action="ForgotPassword" class="small d-block mb-2">Forgot your password?</a>
                    <span class="text-muted small">Don't have an account? </span>
                    <a asp-action="Register" class="small fw-bold text-primary text-decoration-none">Create an account</a>
                </div>
            </div>
        </div>
    </div>
</div>