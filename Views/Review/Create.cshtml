@model ReviewFormViewModel
@{
    ViewData["Title"] = "Rate your service";
}
<link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
<partial name="_BookingDevBanner" />

<div class="py-4" style="max-width: 620px; margin: 0 auto;">
    <div class="card card-modern p-4">
        <h3 class="fw-bold mb-1">Rate your service</h3>
        <p class="text-muted small mb-3">
            @Model.TechnicianName &bull; @Model.BookingDate.ToString("dd MMM yyyy") &bull; @Model.ServicesText
        </p>

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BookingId" />
            <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-3 small"></div>

            <label class="form-label fw-bold">Your rating</label>
            <div>
                <div class="star-input" id="starInput">
                    @for (var i = 5; i >= 1; i--)
                    {
                        <input type="radio" id="star@(i)" name="Rating" value="@i" checked="@(Model.Rating == i)" />
                        <label for="star@(i)" title="@i star@(i > 1 ? "s" : "")"><i class="bi bi-star-fill"></i></label>
                    }
                </div>
                <div class="small text-muted" id="starText" aria-live="polite">Tap a star to rate</div>
                <span asp-validation-for="Rating" class="text-danger small"></span>
            </div>

            <label asp-for="Comment" class="form-label fw-bold mt-3">Comment (optional)</label>
            <textarea asp-for="Comment" rows="4" maxlength="1000" class="form-control form-control-modern" placeholder="Tell others about your experience..."></textarea>
            <span asp-validation-for="Comment" class="text-danger small"></span>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary">Back</a>
                <button type="submit" class="btn btn-yellow-modern px-4"><i class="bi bi-send me-1"></i>Submit review</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/booking.js" asp-append-version="true"></script>
}
