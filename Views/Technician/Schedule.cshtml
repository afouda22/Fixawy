@model Fixawyy.Model_Views.TechnicianScheduleViewModel
@{
    ViewData["Title"] = "Working Hours & Schedule";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-4 mb-4 border-bottom gap-3">
        <div>
            <div class="d-inline-flex align-items-center gap-2 mb-1">
                <span class="brand-pill">
                    <i class="bi bi-clock-history text-warning"></i>
                    <span>Schedule Management</span>
                </span>
            </div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-calendar-week-fill text-primary"></i>
                <span>Weekly Working Schedule</span>
            </h2>
            <p class="text-muted small mb-0">Set your operational hours and off-days for booking slot calculation.</p>
        </div>
        <div>
            <a asp-action="Profile" class="btn btn-outline-modern btn-sm d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Profile</span>
            </a>
        </div>
    </div>

    <form asp-action="Schedule" method="post">
        @Html.AntiForgeryToken()

        <div class="card card-modern card-accent-blue p-4 mb-4 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="text-uppercase small">
                        <tr>
                            <th class="ps-3 py-3 text-white" style="width: 200px;">Day of Week</th>
                            <th class="py-3 text-white">Status</th>
                            <th class="py-3 text-white">Start Shift</th>
                            <th class="py-3 text-white">End Shift</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        @for (int i = 0; i < Model.Schedules.Count; i++)
                        {
                            <tr>
                                <td class="ps-3 py-3">
                                    <input type="hidden" name="Schedules[@i].Id" value="@Model.Schedules[i].Id" />
                                    <input type="hidden" name="Schedules[@i].DayOfWeek" value="@Model.Schedules[i].DayOfWeek" />

                                    <div class="d-flex align-items-center gap-2">
                                        <div class="form-check form-switch mb-0">
                                            <input type="checkbox" name="Schedules[@i].IsWorkingDay" value="true" checked="@Model.Schedules[i].IsWorkingDay" class="form-check-input" id="switch-@i" />
                                            <input type="hidden" name="Schedules[@i].IsWorkingDay" value="false" />
                                        </div>
                                        <label for="switch-@i" class="fw-bold small mb-0 cursor-pointer">
                                            @Model.Schedules[i].DayName
                                        </label>
                                    </div>
                                </td>
                                <td class="py-3">
                                    @if (Model.Schedules[i].IsWorkingDay)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">Working</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted rounded-pill px-2.5 py-1">Off</span>
                                    }
                                </td>
                                <td class="py-3">
                                    <div class="input-group input-group-sm" style="max-width: 140px;">
                                        <span class="input-group-text"><i class="bi bi-clock text-primary"></i></span>
                                        <input type="time" name="Schedules[@i].StartTime" value="@Model.Schedules[i].StartTime" class="form-control form-control-modern" />
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="input-group input-group-sm" style="max-width: 140px;">
                                        <span class="input-group-text"><i class="bi bi-clock-fill text-warning"></i></span>
                                        <input type="time" name="Schedules[@i].EndTime" value="@Model.Schedules[i].EndTime" class="form-control form-control-modern" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                <button type="submit" class="btn btn-yellow-modern px-4 py-2.5">
                    <i class="bi bi-check2-circle me-1"></i>Save Weekly Schedule
                </button>
            </div>
        </div>
    </form>
</div>